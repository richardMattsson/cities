# Database Configuration
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=

# Firebase Credentials
# Point to the service account JSON file (relative to backend container working directory)
GOOGLE_APPLICATION_CREDENTIALS=

# Node Environment
NODE_ENV=development

# Frontend Configuration
VITE_firebaseApiKey=
VITE_firebaseAuthDomain=
VITE_firebaseProjectId=
VITE_firebaseStorageBucket=
VITE_firebaseMessagingSenderId=
VITE_firebaseAppId=

# Optional: Frontend URL for CORS (defaults to http://localhost:3001 in dev)
FRONTEND_URL=http://localhost:3001
