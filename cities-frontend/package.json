{
  "name": "cities-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:e2e": "vite --mode e2e",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e:run": "concurrently --kill-others --success first \"npm run dev:e2e\" \"wait-on http://localhost:5173 && npm run cy:run\""
  },
  "dependencies": {
    "@firebase-oss/ui-react": "^7.0.3",
    "@firebase-oss/ui-styles": "^7.1.0",
    "firebase": "^12.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "concurrently": "^9.2.0",
    "cypress": "^15.11.0",
    "wait-on": "^8.0.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
